{
  "client": {
    "id": "local",
    "name": "PsKloud",
    "country": "PA"
  },
  "database": {
    "driver": "sqlite",
    "sqlite_path": "data/pskloud_demo.db",
    "host": "127.0.0.1",
    "port": 3306,
    "database": "admin000002",
    "user": "",
    "password": "",
    "charset": "utf8mb4"
  },
  "extraction": {
    "mode": "incremental",
    "preview_limit": 150,
    "watermark_field": "fecha_emision",
    "watermark_id_field": "id",
    "watermark_file": "state/last_sync.json",
    "tables": {
      "invoices": "facturas",
      "invoice_lines": "facturas_detalle",
      "customers": "clientes"
    },
    "source": "canonical_view",
    "filter_unexported": false,
    "exported_field": "exportado",
    "use_id_watermark": false,
    "canonical_view": "autohub_v_facturas"
  },
  "mapping": {
    "sage_columns": [
      "Invoice Number",
      "Date",
      "Customer ID",
      "Customer Name",
      "RUC",
      "Item",
      "GL Account",
      "Description",
      "Quantity",
      "Unit Price",
      "Line Amount",
      "Tax Code",
      "Tax Amount",
      "Invoice Total"
    ],
    "field_map": {
      "Invoice Number": "numero_factura",
      "Date": "fecha_emision",
      "Customer ID": "cliente_codigo",
      "Customer Name": "cliente_nombre",
      "RUC": "ruc",
      "GL Account": "cuenta_gl",
      "Description": "descripcion",
      "Quantity": "cantidad",
      "Unit Price": "precio_unitario",
      "Line Amount": "total_linea",
      "Tax Code": "codigo_impuesto",
      "Tax Amount": "itbms_linea",
      "Invoice Total": "total_factura"
    },
    "defaults": {
      "cuenta_gl": "4100",
      "codigo_impuesto": "ITBMS7"
    }
  },
  "validation": {
    "ruc_pattern": "^(?:(?:PE|PI|E|N|NT)-?)?\\d{1,12}-\\d{1,7}-\\d{1,10}$",
    "consumidor_final_values": [
      "CF",
      "CONSUMIDOR FINAL",
      "000000000",
      "0-00-000000"
    ],
    "itbms_rates": [0, 0.07],
    "amount_tolerance": 0.05
  },
  "output": {
    "format": "csv",
    "delimiter": ",",
    "encoding": "utf-8-sig",
    "date_format": "%m/%d/%Y",
    "output_dir": "output"
  }
}
